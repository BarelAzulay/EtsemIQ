// Worker for https://api.etsemiq.com. It is separate from the root
// wrangler.jsonc, which deploys the Whop app. Setup: docs/WHOP-AUTH-SETUP.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "etsemiq-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,

  // Served on *.workers.dev for now, because etsemiq.com's DNS is at Namecheap,
  // not Cloudflare. To move to api.etsemiq.com once the zone is on Cloudflare
  // (guide, step 6): add the route below back, point PUBLIC_URL and the page's
  // ETSEM_API at it, and add the new redirect URI in Whop.
  // "routes": [ { "pattern": "api.etsemiq.com", "custom_domain": true } ],

  // Non-secret settings. Secrets are NOT here. Set them with
  //   npx wrangler secret put WHOP_CLIENT_ID   (and the others in the guide)
  "vars": {
    "PUBLIC_URL": "https://etsemiq-api.etsemiq.workers.dev",
    // One extra allowed origin. It holds the review copy of the site that
    // api/deploy.sh publishes. Never put localhost or a shared host here: this
    // origin can receive session tokens. Empty = none.
    "EXTRA_ORIGIN": "https://etsemiq-preview.etsemiq.workers.dev",
    // Exactly "true": every team member of your Whop business (access_level
    // "admin", moderators included) gets Admin. Off by default: the owner is
    // made Admin by listing their Whop user id in the ADMIN_WHOP_USER_IDS secret.
    "WHOP_TEAM_IS_ADMIN": "false",
    "SESSION_TTL_SECONDS": "43200",
    "REVERIFY_AFTER_SECONDS": "3600",
    "WHOP_SCOPES": "openid profile"
  },

  "observability": { "enabled": true }
}
